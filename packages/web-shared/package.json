{
  "name": "@nodrail/web-shared",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "What the console (apps/web) and the website (apps/site) both use: brand, design tokens, the analytics consent and its privacy filter, the site's constants and the URL namespace both apps share. Source only: each app compiles it.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./analytics/consent": "./src/analytics/consent.tsx",
    "./analytics/posthog": "./src/analytics/posthog.ts",
    "./analytics/sanitize": "./src/analytics/sanitize.ts",
    "./cn": "./src/cn.ts",
    "./e2e": "./e2e/helpers.ts",
    "./logo": "./src/logo.tsx",
    "./not-found": "./src/not-found.tsx",
    "./plans": "./src/plans.ts",
    "./routes": "./src/routes.ts",
    "./security": "./src/security.mjs",
    "./site": "./src/site.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware -D typescript/no-floating-promises -D typescript/no-misused-promises src e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "posthog-js": "^1.454.6",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.65.1",
    "next": "16.4.6",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "next": "16.4.6",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "react": "^19.2.0",
    "typescript": "^7.0.2"
  }
}
