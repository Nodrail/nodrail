{
  "name": "@nodrail/sdk",
  "version": "0.10.0",
  "description": "Build on Nodrail, the open control plane for AI coding agents, from your own code: guard the tools of your agents (Vercel AI SDK, LangChain, OpenAI Agents, MCP), record runs and steps, and evaluate the same rules locally or against your Nodrail server. Includes nodrail-policy and the Claude Code and Codex hook.",
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "policy",
    "policy-engine",
    "control-plane",
    "guardrails",
    "governance",
    "claude-code",
    "codex",
    "copilot",
    "mcp",
    "yaml",
    "langchain",
    "vercel-ai-sdk",
    "openai-agents",
    "sdk",
    "tool-permissions"
  ],
  "homepage": "https://github.com/Nodrail/nodrail/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nodrail/nodrail.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Nodrail/nodrail/issues",
    "email": "hello@nodrail.com"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/engine.ts",
      "default": "./src/index.ts"
    },
    "./protocol": "./src/protocol.ts",
    "./simulator": "./src/simulator.ts",
    "./yaml": "./src/yaml.ts",
    "./compile": "./src/compile.ts",
    "./actions": "./src/actions.ts",
    "./receipts": "./src/receipts.ts",
    "./hook-runs": "./src/hook-runs.ts",
    "./command-line": "./src/command-line.ts",
    "./contracts": "./src/shapes/index.ts",
    "./contract-values": "./src/shapes/values.ts",
    "./shapes": "./src/shapes/index.ts",
    "./files": "./src/files/index.ts",
    "./revision": "./src/revision.ts",
    "./ledger": "./src/run-ledger.ts",
    "./langchain": "./src/client/langchain.ts",
    "./setup": "./src/client/setup.ts",
    "./hooks": "./src/client/hooks.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware -D typescript/no-floating-promises -D typescript/no-misused-promises src tests examples",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/declarations.mjs dist",
    "simulate": "tsx examples/simulate.ts examples/policy.json",
    "test": "vitest run --coverage",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm test:pack",
    "test:pack": "node scripts/verify-pack.mjs",
    "rules": "tsx src/cli.ts"
  },
  "dependencies": {
    "canonicalize": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "langchain": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.4.0",
    "@langchain/langgraph": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.22.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ai": "^7.0.171",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "langchain": "^1.6.5",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "examples",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/engine.js",
        "default": "./dist/index.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "./simulator": {
        "types": "./dist/simulator.d.ts",
        "default": "./dist/simulator.js"
      },
      "./yaml": {
        "types": "./dist/yaml.d.ts",
        "default": "./dist/yaml.js"
      },
      "./compile": {
        "types": "./dist/compile.d.ts",
        "default": "./dist/compile.js"
      },
      "./actions": {
        "types": "./dist/actions.d.ts",
        "default": "./dist/actions.js"
      },
      "./receipts": {
        "types": "./dist/receipts.d.ts",
        "default": "./dist/receipts.js"
      },
      "./hook-runs": {
        "types": "./dist/hook-runs.d.ts",
        "default": "./dist/hook-runs.js"
      },
      "./command-line": {
        "types": "./dist/command-line.d.ts",
        "default": "./dist/command-line.js"
      },
      "./contracts": {
        "types": "./dist/shapes/index.d.ts",
        "default": "./dist/shapes/index.js"
      },
      "./contract-values": {
        "types": "./dist/shapes/values.d.ts",
        "default": "./dist/shapes/values.js"
      },
      "./shapes": {
        "types": "./dist/shapes/index.d.ts",
        "default": "./dist/shapes/index.js"
      },
      "./files": {
        "types": "./dist/files/index.d.ts",
        "default": "./dist/files/index.js"
      },
      "./revision": {
        "types": "./dist/revision.d.ts",
        "default": "./dist/revision.js"
      },
      "./ledger": {
        "types": "./dist/run-ledger.d.ts",
        "default": "./dist/run-ledger.js"
      },
      "./langchain": {
        "types": "./dist/client/langchain.d.ts",
        "default": "./dist/client/langchain.js"
      },
      "./setup": {
        "types": "./dist/client/setup.d.ts",
        "default": "./dist/client/setup.js"
      },
      "./hooks": {
        "types": "./dist/client/hooks.d.ts",
        "default": "./dist/client/hooks.js"
      }
    },
    "bin": {
      "nodrail-policy": "./dist/cli.js",
      "nodrail-claude-hook": "./dist/nodrail-hook.mjs"
    },
    "access": "public",
    "provenance": true
  }
}
