{
  "name": "nodrail",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nodrail/web dev",
    "build": "pnpm --filter @nodrail/web build",
    "start": "pnpm --filter @nodrail/web start",
    "check": "pnpm --filter @nodrail/web check",
    "lint": "pnpm --filter @nodrail/web lint",
    "test": "pnpm --filter @nodrail/web test",
    "test:backend": "pnpm --filter @nodrail/web test:backend",
    "verify:packages": "pnpm -r --workspace-concurrency=1 verify",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm --filter @nodrail/cli... --filter @nodrail/sdk... -r build && node scripts/stage-release.mjs",
    "lint:tools": "oxlint -c .oxlintrc.json scripts packages/agent-plugins/scripts packages/agent-plugins/tools/fuzz-hook.js packages/cli/scripts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1"
  }
}
