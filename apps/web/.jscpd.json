{
  "path": [
    "src",
    "tests",
    "e2e-app",
    "scripts",
    "../../packages/sdk/src",
    "../../packages/sdk/tests",
    "../../packages/sdk/examples",
    "../../packages/cli/src",
    "../../packages/cli/tests",
    "../../packages/web-shared/src",
    "../../packages/web-shared/e2e"
  ],
  "pattern": "**/*.{ts,tsx,mjs,css}",
  "ignore": [
    "**/migrations/2000000000000-Core.ts",
    "**/*.d.ts"
  ],
  "minTokens": 45,
  "minLines": 5,
  "threshold": 0,
  "reporters": [
    "console"
  ],
  "gitignore": true
}
