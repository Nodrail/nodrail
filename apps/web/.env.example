# Server-only; never prefix secrets with NEXT_PUBLIC_.

# Product. `pnpm dev:setup` writes these to .env.local for local development.
# DATABASE_URL must be the restricted application role, never the owner.
DATABASE_URL=
# AUTH_DATABASE_URL is a separate restricted login for authentication.
AUTH_DATABASE_URL=
MIGRATION_DATABASE_URL=
# Managed Postgres requires a trusted PEM CA here or sslmode=verify-full
# in each remote connection URL to use system roots.
DATABASE_CA=
# Explicitly set cloud only for the managed service.
NODRAIL_DEPLOYMENT=self-hosted
# HTTPS public origin. Plain HTTP is supported only on loopback.
APP_ORIGIN=
# Public self-hosting: a single client IP inserted by the trusted ingress.
AUTH_CLIENT_IP_HEADER=
# Product analytics, loaded only after consent. Google Tag Manager is the
# website's only (apps/site).
NEXT_PUBLIC_POSTHOG_KEY=
# The product's own host. Then, at build time, product URLs on APP_HOST drop
# `/app` (app.nodrail.com/acme/…) and old /app links redirect there. To
# override, set NEXT_PUBLIC_SHORT_PRODUCT_URLS=true|false before building;
# leave it unset.
APP_HOST=
# Comma-separated emails allowed to create accounts. Unset means anyone can.
SIGNUP_ALLOWLIST=
# Email. A scheduler calls POST /api/internal/notifications/deliver with
# "Authorization: Bearer $NOTIFICATIONS_SECRET" for retries, silence alerts
# and retention. On Vercel, the daily cron in vercel.json calls it with
# CRON_SECRET instead: set CRON_SECRET (16+ random characters) in the project.
# smtps:// uses implicit TLS. smtp:// requires STARTTLS.
SMTP_URL=
# Local evaluation only: explicitly name the plaintext relay host.
SMTP_PLAINTEXT_HOST=
# For example: Nodrail <hello@nodrail.com>
NOTIFICATIONS_FROM=
NOTIFICATIONS_SECRET=
CRON_SECRET=
# Payments. Only test keys until launch; run `pnpm stripe:check` after setting them.
# STRIPE_API_BASE points at the local stand-in and must be removed for real Stripe.
STRIPE_API_BASE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Earlier Pro price IDs still counted as Pro, comma-separated, during a change.
STRIPE_PRICE_PRO_RECOGNIZED=
