# Copy to .env and set a released server image tag (for example v0.1.0).
NODRAIL_VERSION=
NODRAIL_REGISTRY=ghcr.io/nodrail
# Set both verified sha256 digests for a release. Leave empty for local builds.
NODRAIL_SERVER_DIGEST=
NODRAIL_MIGRATE_DIGEST=
PORT=3000
# Publish only to the trusted reverse proxy by default.
BIND_ADDRESS=127.0.0.1
# Public HTTPS origin. HTTP is supported only on loopback.
APP_ORIGIN=http://localhost:3000

# Generate each value with openssl rand -hex 24. Use URL-safe hex passwords.
POSTGRES_PASSWORD=
OWNER_PASSWORD=
APP_DATABASE_PASSWORD=
AUTH_DATABASE_PASSWORD=
NOTIFICATIONS_SECRET=

# For public sign-in, the trusted proxy must overwrite this header with one client IP.
AUTH_CLIENT_IP_HEADER=
SIGNUP_ALLOWLIST=
# Optional. smtps:// uses implicit TLS; smtp:// requires STARTTLS.
SMTP_URL=
# Loopback evaluation only: explicitly name the plaintext relay host.
SMTP_PLAINTEXT_HOST=
NOTIFICATIONS_FROM=
SCHEDULER_EVERY_SECONDS=300
NODRAIL_MONTHLY_ACTIONS=
NODRAIL_MONTHLY_STEPS=
